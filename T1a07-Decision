<script>
    function myGetNumber() {
        let myInput = document.getElementById('myNum01');

        if (myInput.value.trim() === '') {
            document.getElementById('myDiv01').innerHTML =
                'Please enter a number.';
            return null;
        }

        let myIn01 = Number(myInput.value);

        if (!Number.isFinite(myIn01)) {
            document.getElementById('myDiv01').innerHTML =
                'Please enter a valid number.';
            return null;
        }

        return myIn01;
    }

    function mySimpleIf() {
        let myIn01 = myGetNumber();

        if (myIn01 === null) {
            return;
        }

        if (myIn01 >= 3) {
            document.getElementById('myDiv01').innerHTML =
                myIn01 + ' is greater than or equal to 3.';
        } else {
            document.getElementById('myDiv01').innerHTML =
                'The number is less than 3, so the if condition is false.';
        }
    }

    function myIfElse() {
        let myIn01 = myGetNumber();

        if (myIn01 === null) {
            return;
        }

        if (myIn01 >= 3) {
            document.getElementById('myDiv01').innerHTML =
                myIn01 + ' is greater than or equal to 3.';
        } else {
            document.getElementById('myDiv01').innerHTML =
                myIn01 + ' is less than 3.';
        }
    }

    function myComplexIf() {
        let myIn01 = myGetNumber();

        if (myIn01 === null) {
            return;
        }

        if ((myIn01 != 3 || myIn01 < -3) && myIn01 <= 100) {
            document.getElementById('myDiv01').innerHTML =
                myIn01 + ' meets the complex condition.';
        } else {
            document.getElementById('myDiv01').innerHTML =
                myIn01 + ' does not meet the complex condition.';
        }
    }
</script>

